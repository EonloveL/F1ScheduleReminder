# ============ 必填 ============
# Discord Bot Token（https://discord.com/developers/applications → Bot → Reset Token）
DISCORD_BOT_TOKEN=

# 推送目标频道 ID（逗号分隔多个；频道右键 → Copy Channel ID，需开启开发者模式）
DISCORD_CHANNEL_IDS=

# ============ 推荐 ============
# 界面语言：en（默认）| zh
BOT_LANGUAGE=en

# 时区（推送时间换算/调度用；Discord 消息里的时间戳会按各用户本地时区显示，此处主要影响定时任务触发）
# 例：UTC / Europe/London / America/New_York / Asia/Shanghai
TIMEZONE=UTC

# slash 指令注册的服务器 ID（逗号分隔；填写后指令立即生效，不填则全局注册最长 1 小时生效）
# 开发调试期建议填，正式运行可留空
DISCORD_GUILD_IDS=

# ============ 可选 ============
# 代理（大陆服务器连 discord.com 需要）：http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
PROXY_URL=

# 管理员 Discord 用户 ID（逗号分隔；接收系统异常告警 DM）
ADMIN_USER_IDS=

# 提醒/正赛开赛前是否 @everyone（默认 false，避免打扰）
PING_EVERYONE=false

# 赛季（默认自动取当前年份，一般无需配置）
SEASON=

# 正赛结束后多少分钟推送成绩（默认 30）
POST_RACE_DELAY=30

# 启动时发送在线通知（默认 true）
SEND_STARTUP_MESSAGE=true

# 每周比赛周预告（默认 true，周一 9:00）
WEEKLY_PREVIEW_ENABLED=true

# F1 新闻速递每日推送（默认 false；内容为中文聚合，海外用户一般不需要）
NEWS_ENABLED=false

# ============ AI 问答（/ask，可选） ============
# 不配则 /ask 禁用，其余功能不受影响。支持多家供应商，配哪家用哪家：
# DeepSeek（L0/L1 层推荐）
DEEPSEEK_API_KEY=
# Kimi/月之暗面（L2 成文+联网搜索推荐）
MOONSHOT_API_KEY=
# OpenAI 兼容端点 / OpenRouter / Gemini 也支持，见 common/llm_assistant.py PROVIDERS
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# ============ OpenF1 实时数据（可选，增强数据覆盖） ============
# https://openf1.org 注册账号后填写，用于 stint/车队无线电/天气实测等实时数据
OPENF1_USERNAME=
OPENF1_PASSWORD=

# ============ 本地模型（可选，高配服务器） ============
# 本地 LLM（Ollama 等 OpenAI 兼容端点，免 key；不配模型则不启用）
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
# 向量召回增强：off（默认，实体匹配）| provider（EMBEDDING_* 三项，远程或本地 Ollama）| local（需 pip install fastembed，≥2GB 空闲内存）
MEMORY_EMBEDDING=off
EMBEDDING_BASE_URL=
EMBEDDING_KEY=
EMBEDDING_MODEL=

# ============ Web 依赖功能（可选，默认隐藏） ============
# 自行部署 Web 服务后配置（docker compose --profile web up -d + 反代 https 域名）：
# 评分生命周期推送 + /rate /ratings /dotd /telemetry
RATING_BASE_URL=
# 实时计时面板地址（缺省复用 RATING_BASE_URL），配置后启用 /live
LIVE_BASE_URL=
# 观赛链接（格式：名称|URL，多条分号分隔），配置后启用 /watch
# WATCH_LINKS=F1 TV|https://f1tv.formula1.com;Sky Sports|https://www.skysports.com/f1
WATCH_LINKS=
# 启动时把管理员指令速查卡 DM 给 ADMIN_USER_IDS（默认 true）
ADMIN_GUIDE_PUSH=true
