# 默认构建上下文忽略（用于 deploy/Dockerfile；Dockerfile.discord 使用同名独立 .dockerignore）
.git
.gitignore
.idea
.vscode
**/__pycache__
*.pyc
*.zip
*.log
.env
**/.env
venv
.venv

# 运行时数据不进镜像（data 下仅档案 json 作为种子）
data/*
!data/drivers_profile.json
!data/pu_limits.json
!data/circuits_data.json
!data/prediction_model.json
!data/prediction_dataset_*.json

# 部署/文档/测试/分析等不进机器人镜像
deploy
docs
analysis
tests
README.md
CHANGELOG.md
SECURITY.md
LICENSE

