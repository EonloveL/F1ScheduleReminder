# QQ 官方机器人配置（复制此文件为 .env 并填入真实值）
QQ_APPID=YOUR_APPID_HERE
QQ_APP_SECRET=YOUR_SECRET_HERE
QQ_GROUP_OPENID=YOUR_GROUP_OPENID_HERE
# 多群支持：逗号分隔（优先于QQ_GROUP_OPENID）
QQ_GROUP_OPENIDS=
USE_SANDBOX=true

# LLM配置（可选，配置后启用@机器人AI问答和赛道纪录联网核查）
# Kimi(默认首选,联网): https://platform.moonshot.cn -> API Key管理
# DeepSeek(备用,计费便宜,无联网): https://platform.deepseek.com
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
# 问答首选供应商：kimi=联网优先(默认)，deepseek=备用
LLM_PROVIDER=kimi
DEEPSEEK_MODEL=deepseek-chat
# Kimi模型（moonshot-v1-auto 已于2026年下线/404）：可用 kimi-k2.6（联网）/ kimi-k3
LLM_MODEL=kimi-k2.6

# 客户端联网搜索（可选，为 DeepSeek 备用路径补联网；Kimi 有内建联网无需配置）
# Tavily（全球，免费1000次/月）或 博查（国内），填哪个用哪个
TAVILY_API_KEY=
BOCHA_API_KEY=

# 功能开关（可选，默认均为true）
LLM_ASK_ENABLED=true
WEEKLY_PREVIEW_ENABLED=true
WEEKLY_VERIFY_LAP_RECORD=true
# 问答看门狗（秒）：超过 NOTICE_AFTER 发进度提示；HARD_TIMEOUT 硬超时（默认60/600，超时后迟到补发）
LLM_ASK_NOTICE_AFTER=60
LLM_ASK_HARD_TIMEOUT=600

# 升级件/PU数据源：fia=FIA官方文档（默认，权威含备注）；cosmos=第三方F1Cosmos
UPGRADE_DATA_SOURCE=fia

# 遥测数据（F1官方livetiming归档）：机房IP被F1 CDN封锁(403)时配置以下任一项
# 方案A（推荐）：部署 cf_worker_livetiming_relay.js 到 Cloudflare Worker 后填：
# TELEMETRY_BASE_URL=https://你的worker.workers.dev/static
# 方案B：已有代理时填：
# TELEMETRY_PROXY=http://代理地址:端口
