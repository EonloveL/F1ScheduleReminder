# ==================== 必填 ====================
# QQ 开放平台 (https://q.qq.com) → 开发设置
QQ_APPID=YOUR_APPID_HERE
QQ_APP_SECRET=YOUR_SECRET_HERE
# 群 group_openid（可运行 python get_group_openid.py 后 @机器人 获取）
QQ_GROUP_OPENID=YOUR_GROUP_OPENID_HERE
# 多群支持（逗号分隔，优先于 QQ_GROUP_OPENID）
QQ_GROUP_OPENIDS=
USE_SANDBOX=false

# Webhook 验签密钥（q.qq.com → 开发设置 → 验证密钥）
# QQ 平台回调地址填写：https://你的域名/bot/callback
BOT_WEBHOOK_SECRET=
WEBHOOK_PORT=8090
WEBHOOK_EVENT_WORKERS=10

# ==================== AI 问答（可选，不配置则 @机器人 AI 功能禁用）====================
# Kimi（成文/视觉，默认首选）: https://platform.moonshot.cn
# DeepSeek（改写/取数决策，便宜快速）: https://platform.deepseek.com
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
LLM_PROVIDER=kimi
DEEPSEEK_MODEL=deepseek-chat
# Kimi 模型：moonshot-v1-auto 已于 2026 年下线（404），可用 kimi-k2.6（多模态）/ kimi-k3
LLM_MODEL=kimi-k2.6
LLM_ASK_ENABLED=true
LLM_MAX_CONCURRENCY=4
LLM_ASK_NOTICE_AFTER=60
LLM_ASK_HARD_TIMEOUT=600

# 联网搜索（可选；不配置则 DeepSeek 走模型内置搜索，Kimi 自动用 $web_search）
# Tavily（免费 1000 次/月）https://tavily.com ｜ 博查（国内）https://bochaai.com
TAVILY_API_KEY=
BOCHA_API_KEY=

# ==================== 知识库（可选）====================
KB_ENABLED=true
# 管理员 openid 列表（逗号分隔；/kb 审核指令 + 候选 DM 通知的接收人）
ADMIN_OPENIDS=

# ==================== 功能开关 ====================
POST_RACE_DELAY=30
LOG_LEVEL=INFO
WEEKLY_PREVIEW_ENABLED=true
WEEKLY_VERIFY_LAP_RECORD=true
DM_SESSION_RESULT=true
NEWS_ENABLED=true
# 升级件/PU 数据源：fia=FIA 官方文档（默认，权威）；cosmos=第三方 F1Cosmos
UPGRADE_DATA_SOURCE=fia

# ==================== 网页服务 ====================
# 评分/实时面板公网地址（群友点击访问，填你的 HTTPS 域名）
RATING_ENABLED=true
RATING_BASE_URL=https://your-domain.example.com
# 实时面板链接单独配置（默认复用 RATING_BASE_URL）
LIVE_BASE_URL=

# ==================== 遥测数据（可选）====================
# F1 官方 livetiming 归档国内 IP 被 CDN 拦截(403) 时二选一：
# 方案A（推荐）：用 cf_worker_livetiming_relay.js 部署 Cloudflare Worker：
# TELEMETRY_BASE_URL=https://你的worker.workers.dev/static
# 方案B（已有代理时）：
# TELEMETRY_PROXY=http://你的地址:端口

# ==================== 实时面板（可选）====================
# Team Radio 语音转写（f1-qqbot-live 容器）
# WHISPER_MODEL=base
# WHISPER_LANGUAGE=en
# OpenF1 实时档需 sponsor 账号（https://openf1.org/auth.html），仅看历史数据可不填
OPENF1_USERNAME=
OPENF1_PASSWORD=
